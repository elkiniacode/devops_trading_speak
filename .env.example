# FinAlly environment variables.
# Copy this file to .env (the start scripts do it for you) and fill in what you need.
# Docker reads .env literally: no quotes around values, no spaces around '='.

# ----- AI chat -----

# OpenRouter API key for the AI assistant (LiteLLM -> OpenRouter -> Cerebras).
# Optional: without it (and without LLM_MOCK=true) everything works except chat.
OPENROUTER_API_KEY=

# true = deterministic mock replies with no network or API key (used by the E2E tests).
LLM_MOCK=false

# ----- Market data -----

# Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in simulator (recommended).
MASSIVE_API_KEY=

# Seconds between Massive polls. The free tier allows 5 calls/min, so keep this at 15 or more.
MASSIVE_POLL_SECONDS=15

# Integer seed for reproducible simulator prices. Empty = random.
SIM_SEED=

# ----- Paths (leave unset unless running outside Docker with a custom layout) -----

# SQLite file. Default: <repo>/db/finally.db. The Docker image sets /app/db/finally.db.
# DB_PATH=

# Built frontend served at /. Default: <repo>/backend/static. The Docker image sets /app/backend/static.
# STATIC_DIR=

# ----- Local development only -----

# Comma-separated origins allowed by CORS, e.g. http://localhost:3000 for the Next.js dev server.
# CORS is disabled when unset. Not needed in Docker.
# CORS_ORIGINS=

CHARLA_ADMIN_KEY=holamundo2026
CHARLA_PHONE_AT=off
