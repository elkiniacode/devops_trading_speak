# syntax=docker/dockerfile:1
#
# FinAlly for Railway: the live-talk ("charla") deploy. Same image as ./Dockerfile, with the
# changes Railway needs:
#   - no `RUN --mount=type=cache` (Railway's builder rejects cache mounts without an id);
#   - uvicorn listens on $PORT and trusts the proxy's X-Forwarded-* headers, so redirects such
#     as /charla -> /charla/ keep https behind Railway's edge.
# railway.json points Railway at this file. Runtime settings (CHARLA_ONLY, keys, ...) are
# Railway service variables; nothing secret is baked into the image.
#
# Local check (never port 8000 on the dev machine; 8020 is free):
#   docker build -f Dockerfile.railway -t finally-charla .
#   docker run -d --name finally-charla-test -p 127.0.0.1:8020:8000 -e PORT=8000 \
#     -e CHARLA_ONLY=true -e LLM_MOCK=true -e CHARLA_DEV_LINKS=true -e CHARLA_ADMIN_KEY=dev finally-charla

# ---------------------------------------------------------------------------
# Stage 1: build the Next.js static export (frontend/out)
# ---------------------------------------------------------------------------
FROM node:24-slim AS frontend

WORKDIR /build/frontend

# Same-origin API in production; overrides any NEXT_PUBLIC_API_BASE from a frontend .env file.
ENV NEXT_PUBLIC_API_BASE="" \
    NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# Dependencies first, so source edits don't invalidate the npm ci layer.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Python runtime
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3.12 \
    LITELLM_LOCAL_MODEL_COST_MAP=True

# Unprivileged user. /app/db is the volume mount point. Railway volumes are owned by root, so
# the service sets RAILWAY_RUN_UID=0 to run as root there; locally the image runs as 'finally'.
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin finally \
    && mkdir -p /app/db \
    && chown finally:finally /app/db

WORKDIR /app/backend

# Dependencies first (cached until pyproject.toml or uv.lock change).
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend/app ./app
COPY --from=frontend /build/frontend/out ./static

ENV PATH="/app/backend/.venv/bin:$PATH" \
    DB_PATH=/app/db/finally.db \
    STATIC_DIR=/app/backend/static

USER finally

EXPOSE 8000

# Used by plain `docker run` only; Railway checks railway.json's healthcheckPath instead.
# python:3.12-slim has no curl; the stdlib is enough (R37). Follows $PORT like the server.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import os, sys, urllib.request; port = os.environ.get('PORT') or '8000'; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:' + port + '/api/health', timeout=4).status == 200 else 1)"]

# Exactly one worker (R20): the room state, simulator and locks live in this process.
# Railway sets $PORT; --forwarded-allow-ips '*' makes uvicorn trust X-Forwarded-Proto from
# Railway's proxy (the container is only reachable through it). Open SSE streams never end on
# their own, so cap graceful shutdown; `exec` lets uvicorn receive SIGTERM directly.
CMD ["sh", "-c", "exec /app/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --forwarded-allow-ips '*' --timeout-graceful-shutdown 3 --no-access-log"]
